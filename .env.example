# Copy to .env next to docker-compose.yml. All values are optional.

# First admin account, created only when the user database is empty (fresh volume).
# Leave the password empty to have one generated and printed in the logs.
VISOR_ADMIN_USER=admin
VISOR_ADMIN_PASSWORD=
# Session lifetime in hours; cookie Secure flag: auto (https via X-Forwarded-Proto) | true | false
VISOR_SESSION_HOURS=168
VISOR_COOKIE_SECURE=auto
# Minutes with nobody online before the simulation sleeps to save CPU/memory (0 = never).
# The recorder keeps running; the first sign-in wakes it.
VISOR_IDLE_SLEEP_MIN=5

# AI coach: plain-language debriefs and answers come from Claude when a key is set
# (https://console.anthropic.com). Without it the coach still explains, grades and hints.
# Sent to Claude: the session's situations (callsigns, levels, predictions, grades), never names.
ANTHROPIC_API_KEY=
VISOR_COACH_MODEL=claude-opus-5-5
VISOR_COACH_EFFORT=medium
VISOR_COACH_DAILY_QUESTIONS=60
# Private training sandboxes (tutorial and exercises) running at once.
VISOR_MAX_SANDBOXES=20

# Published image to run (from the release workflow), e.g. ghcr.io/gonzaloalonso/atc-trainer:2.1;
# leave empty to build locally.
VISOR_IMAGE=

# OpenSky API client (https://opensky-network.org -> Account -> API client).
# Without it the recorder runs anonymously: one Europe snapshot every 15 minutes.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Decision-model endpoint for the "jev" agent (see atc/agents/jev.py).
JEV_ENDPOINT=
JEV_API_KEY=
JEV_MODEL=
